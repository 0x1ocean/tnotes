---
import { getCollection, render } from "astro:content";
import Article from "@/layouts/Article.astro";

export async function getStaticPaths() {
  const all = await getCollection("usecases");
  return all.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const others = (await getCollection("usecases")).filter((e) => e.id !== entry.id).sort((a, b) => a.data.order - b.data.order);
---

<Article title={entry.data.title} description={entry.data.description} hub={{ label: "Use cases", href: "/for" }} articleType="TechArticle">
  <Content />
  <Fragment slot="related">
    <h2 id="more">tnotes for…</h2>
    <ul class="not-prose grid sm:grid-cols-2 gap-x-6 gap-y-1 text-sm">
      {others.map((e) => <li><a href={`/for/${e.id}`} class="text-primary hover:underline">{e.data.persona}</a></li>)}
    </ul>
  </Fragment>
</Article>
