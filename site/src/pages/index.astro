---
import Base from "@/layouts/Base.astro";
import AsciiLogo from "@/components/AsciiLogo.astro";
import FakeTui from "@/components/FakeTui.astro";
import FeatureCard from "@/components/FeatureCard.astro";
import Code from "@/components/Code.astro";
import Card from "@/components/Card.astro";
import Faq from "@/components/Faq.astro";
import Section from "@/components/Section.astro";
import InstallTabs from "@/components/InstallTabs.astro";
import { AGENT_JSON, CONFIG_SAMPLE, EXPLORE, FAQ, FEATURES, INSTALL, PILLARS, WORKFLOWS } from "@/data/landing";
import { DESCRIPTION, REPO, SITE_NAME, VERSION } from "@/lib/meta";
import { faqPage } from "@/lib/schema";
---

<Base title={SITE_NAME} description={DESCRIPTION} jsonLd={[faqPage(FAQ)]}>
  <section class="pt-14 sm:pt-20 pb-10">
    <AsciiLogo />
    <h1 class="mt-6 text-2xl sm:text-3xl font-bold text-accent-foreground max-w-3xl">
      Terminal notes: Markdown files with folders, <span class="text-tag">#tags</span>, <span class="text-primary">[[links]]</span> and a mouse-first TUI.
    </h1>
    <p class="mt-4 max-w-2xl text-muted-foreground leading-7">
      Fast, minimal note-taking that never leaves your terminal. Plain <code class="text-code">.md</code> on disk, live Markdown highlighting while you type, emacs or vim keys, and a headless JSON CLI so scripts and AI agents work the same vault.
    </p>
    <div class="mt-6 flex flex-wrap items-center gap-3 text-sm">
      <a href="#install" class="inline-flex h-9 items-center px-4 rounded-md bg-primary text-primary-foreground font-bold hover:bg-primary/90">install</a>
      <a href="/docs" class="inline-flex h-9 items-center px-4 rounded-md border border-border hover:bg-accent">read the docs</a>
      <a href={REPO} rel="noopener" class="inline-flex h-9 items-center px-4 text-muted-foreground hover:text-primary">github ↗</a>
      <span class="text-xs text-muted-foreground">v{VERSION} · MIT · macOS &amp; Linux</span>
    </div>
  </section>

  <section class="pb-16" aria-labelledby="demo-h">
    <h2 id="demo-h" class="sr-only">Interface preview</h2>
    <FakeTui />
    <p class="mt-3 text-xs text-muted-foreground">Left: folders, tags and the note list. Right: tabs and the editor. Everything is clickable; everything has a key.</p>
  </section>

  <Section id="why" title="Why tnotes" srOnly class="grid gap-8 md:grid-cols-3">
    {
      PILLARS.map((p, i) => (
        <div>
          <h3 class="font-bold text-primary">
            <span class="text-muted-foreground">0{i + 1}</span> {p.title}
          </h3>
          <p class="mt-2 text-sm text-muted-foreground leading-6" set:html={p.body} />
        </div>
      ))
    }
  </Section>

  <Section id="features" title="Features">
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">{FEATURES.map((f) => <FeatureCard {...f} />)}</div>
  </Section>

  <Section id="workflow" title="How it feels">
    <div class="grid gap-6 lg:grid-cols-3">
      {
        WORKFLOWS.map((w) => (
          <div>
            <h3 class="font-bold">{w.title}</h3>
            <p class="mt-1 mb-3 text-sm text-muted-foreground leading-6" set:html={w.body} />
            <Code code={w.code} />
          </div>
        ))
      }
    </div>
  </Section>

  <Section id="agents" title="Built for AI agents" class="mt-4 grid gap-8 lg:grid-cols-[1fr_1.2fr] items-start">
    <div>
      <p class="text-sm text-muted-foreground leading-6">
        The CLI is the agent interface: no daemon, no API keys, no plugin, just files and JSON. Point an agent at your vault and let it read, search and write notes while you keep the TUI open. Edits show up live in both directions; a note with unsaved edits in the TUI is never overwritten.
      </p>
      <p class="mt-3 text-sm text-muted-foreground leading-6">
        <code>links</code> and <code>backlinks</code> in the JSON let an agent walk the note graph. Ids (<code>root/sub/stem</code>) are the same in every command.
      </p>
      <a href="/agents" class="mt-4 inline-block text-sm text-primary hover:underline">agent recipes →</a>
    </div>
    <Code code={AGENT_JSON} />
  </Section>

  <Section id="install" title="Install">
    <p class="mb-6 text-sm text-muted-foreground max-w-2xl">
      One binary, no account, no daemon. <span class="text-foreground">v{VERSION}</span> · macOS and Linux · MIT. Pick your system; the first option is the one to use unless you have a reason not to.
    </p>
    <div class="max-w-3xl"><InstallTabs oses={INSTALL} /></div>
    <div class="mt-10 max-w-3xl grid gap-6 md:grid-cols-2">
      <div>
        <h3 class="font-bold">Verify</h3>
        <Code code={`$ tnotes --version\ntnotes ${VERSION}`} />
      </div>
      <div>
        <h3 class="font-bold">First run</h3>
        <Code code={`$ tnotes              # asks where notes live, default ~/Documents/notes\n$ tnotes ~/notes      # or: add this folder to your roots and open it\n$ tnotes --dir ~/tmp  # or: only this folder, for this session`} />
      </div>
    </div>
    <p class="mt-4 text-xs text-muted-foreground">Next: <a href="/docs/getting-started" class="text-primary hover:underline">getting started</a> · <a href="/docs/keys" class="text-primary hover:underline">keys</a> · <a href="/docs/config" class="text-primary hover:underline">config</a>.</p>
  </Section>

  <Section id="sync" title="Sync and encryption are the file system's job" class="mt-4 grid gap-8 md:grid-cols-2">
    <div>
      <p class="text-sm text-muted-foreground leading-6">
        Put a root inside Syncthing, iCloud Drive, Dropbox or a git repo. Changes from another device show up live; saves are atomic so a syncer never sees a half-written note; concurrent edits become a conflict copy, never a lost one.
      </p>
      <p class="mt-3 text-sm text-muted-foreground leading-6">
        Encrypt the folder, not the notes: FileVault, an encrypted <code>.dmg</code>, <code>gocryptfs</code> or <code>fscrypt</code>. Point <code>roots</code> at the mounted path and everything keeps working.
      </p>
      <a href="/docs/sync" class="mt-4 inline-block text-sm text-primary hover:underline">sync recipes →</a>
    </div>
    <Code code={CONFIG_SAMPLE} />
  </Section>

  <Section id="explore" title="Read more">
    <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">{EXPLORE.map((c) => <li><Card {...c} /></li>)}</ul>
  </Section>

  <Section id="faq" title="FAQ">
    <Faq items={FAQ} />
  </Section>
</Base>
