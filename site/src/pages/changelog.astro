---
import { readFileSync } from "node:fs";
import { resolve } from "node:path";
import { md } from "@/lib/markdown";
import Base from "@/layouts/Base.astro";
import { RELEASES, VERSION } from "@/lib/meta";

/* The crate's CHANGELOG.md, minus its own `# Changelog` line so the page has one h1. */
const code = await md(readFileSync(resolve("../CHANGELOG.md"), "utf8").replace(/^# .*\n/, ""));
---

<Base title="Changelog" description={`What changed in each tnotes release, up to v${VERSION}. Rendered from the repository's CHANGELOG.md.`} type="article">
  <article class="prose max-w-3xl pt-10">
    <h1>Changelog</h1>
    <p class="text-muted-foreground -mt-2">
      Rendered from <code>CHANGELOG.md</code> in the repository; each section is also the <a href={RELEASES}>GitHub release</a> note.
    </p>
    <Fragment set:html={code} />
  </article>
</Base>
