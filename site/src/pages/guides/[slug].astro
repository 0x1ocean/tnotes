---
import { getCollection, render } from "astro:content";
import Article from "@/layouts/Article.astro";

export async function getStaticPaths() {
  const all = await getCollection("guides");
  return all.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const others = (await getCollection("guides")).filter((e) => e.id !== entry.id).sort((a, b) => a.data.order - b.data.order);
const published = entry.data.published.toISOString().slice(0, 10);
---

<Article title={entry.data.title} description={entry.data.description} hub={{ label: "Guides", href: "/guides" }} datePublished={published}>
  <p class="text-xs text-dim -mt-2">published {published}</p>
  <Content />
  <Fragment slot="related">
    <h2 id="more">More guides</h2>
    <ul class="not-prose grid gap-y-1 text-sm">
      {others.map((e) => <li><a href={`/guides/${e.id}`} class="text-primary hover:underline">{e.data.title}</a></li>)}
    </ul>
  </Fragment>
</Article>
