---
/* One item of a numbered vertical stepper: a badge on the parent <ol>'s
   left border, a title, and the slot content. */
interface Props {
  n: string;
  title: string;
  last?: boolean;
}
const { n, title, last = false } = Astro.props;
---

<li class:list={["relative pl-8 sm:pl-10", last ? "pb-0" : "pb-10"]}>
  <span aria-hidden="true" class="absolute -left-4 sm:-left-5 top-0 size-8 sm:size-10 rounded-full border border-border bg-background text-primary text-xs sm:text-sm font-bold flex items-center justify-center">
    {n}
  </span>
  <h3 class="font-bold text-accent-foreground h-8 sm:h-10 flex items-center">{title}</h3>
  <div class="mt-3"><slot /></div>
</li>
