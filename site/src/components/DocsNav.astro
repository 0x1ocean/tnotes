---
import type { CollectionEntry } from "astro:content";

interface Props {
  docs: CollectionEntry<"docs">[];
  current?: string;
}
const { docs, current } = Astro.props;
---

<nav class="text-sm lg:sticky lg:top-16 lg:self-start" aria-label="Documentation">
  <p class="text-dim text-xs mb-2">▾ docs</p>
  <ul class="space-y-1 max-lg:flex max-lg:flex-wrap max-lg:gap-x-4">
    {
      docs.map((d) => (
        <li>
          <a
            href={`/docs/${d.id}`}
            aria-current={d.id === current ? "page" : undefined}
            class:list={["block pl-3 border-l hover:text-primary", d.id === current ? "border-primary text-foreground" : "border-border text-muted-foreground"]}
          >
            {d.data.title}
          </a>
        </li>
      ))
    }
    <li>
      <a href="/agents" class="block pl-3 border-l border-border text-muted-foreground hover:text-primary">AI agents</a>
    </li>
    <li>
      <a href="/changelog" class="block pl-3 border-l border-border text-muted-foreground hover:text-primary">Changelog</a>
    </li>
  </ul>
</nav>
