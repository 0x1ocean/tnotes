---
import "@/styles/global.css";
import fontUrl from "@/assets/fonts/jetbrains-mono-400-700.woff2?url";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { AUTHOR, AUTHOR_ID, DESCRIPTION, RELEASE_DATE, REPO, SITE_NAME, VERSION } from "@/lib/meta";

interface Props {
  title: string;
  description?: string;
  /** Extra JSON-LD nodes merged into the page graph. */
  jsonLd?: Record<string, unknown>[];
  /** `article` for docs/changelog, `website` for the landing. */
  type?: "website" | "article";
}

const { title, description = DESCRIPTION, jsonLd = [], type = "website" } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
/* Every page gets a Markdown twin at build (integrations/markdown-twins.ts). */
const markdown = `${Astro.url.pathname.replace(/\/$/, "") || "/index"}.md`;
const og = new URL("/og.png", Astro.site);
/* Brand suffix only when it fits Google's ~60-char title cutoff; long editorial titles stand alone. */
const fullTitle = title === SITE_NAME ? `${SITE_NAME} — terminal Markdown notes with #tags, [[links]] and a CLI` : title.length > 52 ? title : `${title} · ${SITE_NAME}`;

/* Entity graph on every page: the app, its source, the site, the author.
   Pages append their own nodes (Article, FAQPage, …) and reference these by @id. */
const graph = [
  {
    "@type": "SoftwareApplication",
    "@id": `${Astro.site}#app`,
    name: SITE_NAME,
    alternateName: "terminal notes",
    applicationCategory: "UtilitiesApplication",
    applicationSubCategory: "Note-taking",
    operatingSystem: "macOS, Linux",
    softwareVersion: VERSION,
    dateModified: RELEASE_DATE,
    description: DESCRIPTION,
    url: Astro.site?.toString(),
    downloadUrl: `${REPO}/releases`,
    installUrl: new URL("/docs/getting-started", Astro.site).toString(),
    releaseNotes: new URL("/changelog", Astro.site).toString(),
    softwareHelp: { "@type": "CreativeWork", url: new URL("/docs", Astro.site).toString() },
    featureList: [
      "Plain Markdown files on disk",
      "Folders as directories, #tags parsed from text",
      "[[Wikilinks]] with completion and backlinks",
      "Tabs with a preview tab",
      "Live Markdown highlighting",
      "Emacs or vim keys",
      "Mouse support",
      "Headless CLI with JSON output for scripts and AI agents",
    ],
    license: "https://opensource.org/license/mit",
    isAccessibleForFree: true,
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD", availability: "https://schema.org/InStock" },
    screenshot: og.toString(),
    author: { "@id": AUTHOR_ID },
    sameAs: [REPO, "https://crates.io/crates/tnotes"],
  },
  {
    "@type": "SoftwareSourceCode",
    "@id": `${REPO}#source`,
    name: "tnotes source",
    codeRepository: REPO,
    programmingLanguage: "Rust",
    runtimePlatform: "Terminal",
    license: "https://opensource.org/license/mit",
    targetProduct: { "@id": `${Astro.site}#app` },
    author: { "@id": AUTHOR_ID },
  },
  {
    "@type": "WebSite",
    "@id": `${Astro.site}#site`,
    name: SITE_NAME,
    url: Astro.site?.toString(),
    about: { "@id": `${Astro.site}#app` },
    publisher: { "@id": AUTHOR_ID },
    inLanguage: "en",
  },
  AUTHOR,
  ...jsonLd,
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="text/markdown" href={markdown} title="Markdown version" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#242933" />
    <meta name="color-scheme" content="dark" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content="tnotes: Markdown notes in your terminal with folders, #tags, [[links]], a mouse-first TUI and a JSON CLI for AI agents" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />

    <script type="application/ld+json" set:html={JSON.stringify({ "@context": "https://schema.org", "@graph": graph })} />
    {import.meta.env.PROD && <script defer src="/_vercel/insights/script.js" />}
  </head>
  <body class="min-h-dvh flex flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:bg-card focus:px-3 focus:py-2">
      skip to content
    </a>
    <Header />
    <main id="main" class="flex-1 w-full max-w-6xl mx-auto px-4 sm:px-6">
      <slot />
    </main>
    <Footer />
    <script>
      /* The only client JS on the site: copy buttons rendered by Code.astro. */
      document.addEventListener("click", async (e) => {
        const b = (e.target as Element).closest<HTMLButtonElement>("button[data-copy]");
        if (!b) return;
        await navigator.clipboard.writeText(b.dataset.copy ?? "");
        b.textContent = "✓";
        b.classList.add("text-ok");
        setTimeout(() => {
          b.textContent = "⧉";
          b.classList.remove("text-ok");
        }, 1500);
      });
    </script>
  </body>
</html>
