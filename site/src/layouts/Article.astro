---
import Base from "@/layouts/Base.astro";

/** Long-form page under a hub (/for, /guides, /glossary): breadcrumb,
 *  single h1, prose body, optional "related" slot. Adds BreadcrumbList. */
interface Props {
  title: string;
  description: string;
  hub: { label: string; href: string };
  jsonLd?: Record<string, unknown>[];
  /** Article subtype: TechArticle for docs-like, Article for editorial. */
  articleType?: "Article" | "TechArticle";
  datePublished?: string;
}
const { title, description, hub, jsonLd = [], articleType = "Article", datePublished } = Astro.props;
const here = new URL(Astro.url.pathname, Astro.site).toString();

const ld = [
  {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: hub.label, item: new URL(hub.href, Astro.site).toString() },
      { "@type": "ListItem", position: 2, name: title, item: here },
    ],
  },
  {
    "@type": articleType,
    headline: title,
    description,
    ...(datePublished && { datePublished, dateModified: datePublished, author: { "@type": "Person", name: "0x1ocean", url: "https://github.com/0x1ocean" } }),
    about: { "@id": `${Astro.site}#app` },
  },
  ...jsonLd,
];
---

<Base title={title} description={description} type="article" jsonLd={ld}>
  <article class="prose max-w-3xl pt-10">
    <p class="text-xs text-muted-foreground mb-2">
      <a href={hub.href} class="hover:text-primary">{hub.label.toLowerCase()}</a> <span class="text-dim">/</span> {Astro.url.pathname.split("/").pop()}
    </p>
    <h1>{title}</h1>
    <p class="text-muted-foreground -mt-2">{description}</p>
    <slot />
    <slot name="related" />
  </article>
</Base>
